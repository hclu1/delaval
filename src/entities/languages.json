{
  "name": "languages",
  "type": "object",
  "required": [
    "code",
    "name",
    "nativeName",
    "isActive",
    "isDefault",
    "creator",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "code": {
      "bsonType": "string",
      "description": "Code ISO de la langue (ex: fr, en, de)"
    },
    "name": {
      "bsonType": "string",
      "description": "Nom de la langue en anglais"
    },
    "nativeName": {
      "bsonType": "string",
      "description": "Nom de la langue dans sa propre langue"
    },
    "isActive": {
      "bsonType": "bool",
      "description": "Indique si la langue est activée"
    },
    "isDefault": {
      "bsonType": "bool",
      "description": "Indique si c'est la langue par défaut"
    },
    "creator": {
      "bsonType": "string",
      "description": "ID du créateur"
    },
    "createdAt": {
      "bsonType": "string",
      "title": "datetime",
      "description": "Date de création ISO 8601"
    },
    "updatedAt": {
      "bsonType": "string",
      "title": "datetime",
      "description": "Date de modification ISO 8601"
    },
    "creatorEmail": {
      "bsonType": "string",
      "description": "Creator user email"
    }
  }
}